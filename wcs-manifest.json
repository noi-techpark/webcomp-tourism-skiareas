    }
  ],
  "image": "wcs-logo.png",
  "searchTags": [
    "map"
  ],
  "dist": {
    "basePath": "dist",
    "files": [
      "map_widget.min.js"
    ]
  },
  "configuration": {
    "tagName": "map-widget",
    "options": [
      {
        "key": "types",
        "type": "multiselect",
        "label": "Show slopes and/or lifts",
        "required": false,
        "options": {
          "values": [
            "slopes",
            "lifts"
          ],
          "default": "slopes,lifts"
        }
      },
      {
        "key": "language",
        "type": "select",
        "label": "Two letter key for the language to be used, if omitted the widget will use the lang attribute of the closest parent element. Fallback and Default is `en`",
        "required": false,
        "options": {
          "values": [
            "de",
            "it",
            "en"
          ],
          "default": "en"
        }
      },
      {
        "key": "source",
        "type": "multiselect",
        "label": "Data provider for slopes, lifts and ski areas: lts, dss, discoverswiss. Default is `dss`",
        "required": false,
        "options": {
          "values": [
            "lts",
            "dss",
            "discoverswiss"
          ],
          "default": "dss"
        }
      },
      {
        "key": "centermap",
        "type": "text",
        "label": "centermap: ex. 46.7728692,10.7916716,14",
        "required": false,
        "options": {
          "default": ""
        }
      }
    ]
  }
}
